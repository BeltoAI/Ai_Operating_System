// Copy to Secrets.xcconfig and fill in. That file is gitignored.
//
// xcconfig treats "//" as the start of a comment, so SUPABASE_HOST is the bare host with no
// scheme — Swift prepends https:// itself.
SUPABASE_HOST =
SUPABASE_ANON_KEY =
// Must be an *iOS* OAuth client: Google ties the redirect scheme to the client type.
GOOGLE_OAUTH_CLIENT_ID =
DEVELOPMENT_TEAM =
